{
  "version": 2,
  "name": "omnitrix-portal",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "framework": null,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node", "config": { "runtime": "nodejs18.x", "maxDuration": 300 } },
    { "src": "index.html", "use": "@vercel/static" }
  ]
}
